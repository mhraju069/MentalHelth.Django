# Django Core
SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOW_ORIGINS=localhost:8000,localhost:3000
CSRF_TRUSTED_ORIGINS=localhost:8000,localhost:3000

# Database
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis & Celery
REDIS_HOST=redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ==============================================================================
# Backblaze B2 Cloud Storage (S3-Compatible)
# ==============================================================================
# Set USE_BACKBLAZE=True when you want uploads (ImageField, FileField) stored in B2
USE_BACKBLAZE=False

# Backblaze B2 Application Key ID (Key ID)
BACKBLAZE_KEY_ID=your_backblaze_key_id

# Backblaze B2 Application Key (Secret Key)
BACKBLAZE_APPLICATION_KEY=your_backblaze_application_key

# Backblaze B2 Bucket Name
BACKBLAZE_BUCKET_NAME=your_backblaze_bucket_name

# Region (found in your bucket details, e.g. us-west-004, us-east-005, eu-central-003)
BACKBLAZE_REGION=us-west-004

# S3 Endpoint URL (e.g. https://s3.us-west-004.backblazeb2.com)
BACKBLAZE_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com

# Optional: CDN / Custom domain for public media (e.g. cdn.yourdomain.com or f004.backblazeb2.com/file/your-bucket)
# BACKBLAZE_CUSTOM_DOMAIN=

# Optional: Query string auth (set True if bucket is private, False for public assets)
BACKBLAZE_QUERYSTRING_AUTH=False

# Email
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CONTACT_EMAIL=

# Third-party Integrations
OPENAI_API_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
